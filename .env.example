# Copy to .env and fill in your Anthropic API key before running docker compose up

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override model defaults
CLAUDE_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Set automatically by docker-compose.yml when running via Docker.
# Only needed here if you run the backend locally without Docker.
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag_explorer
ELASTICSEARCH_URL=http://localhost:9200
