# Copy to .env and fill in before running `docker compose up`

# Required for embeddings + LLM generation
OPENAI_API_KEY=

# Optional: model overrides
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1

# Set automatically by docker-compose.yml when running via Docker.
# Only needed here if you run the backend locally without Docker.
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag_explorer
ELASTICSEARCH_URL=http://localhost:9200
